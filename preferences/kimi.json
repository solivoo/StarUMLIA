{
  "id": "kimi",
  "name": "Kimi AI",
  "schema": {
    "kimi": {
      "text": "Kimi (Moonshot)",
      "type": "section"
    },
    "kimi.apiKey": {
      "text": "API Key",
      "description": "API Key de https://platform.kimi.ai (Bearer).",
      "type": "string",
      "default": ""
    },
    "kimi.baseUrl": {
      "text": "Base URL",
      "description": "Endpoint OpenAI-compatible. Default oficial Moonshot.",
      "type": "string",
      "default": "https://api.moonshot.ai/v1"
    },
    "kimi.model": {
      "text": "Modelo",
      "description": "Modelo Kimi (oficial: kimi-k3). Ver https://platform.kimi.ai/docs/overview",
      "type": "dropdown",
      "options": [
        { "value": "kimi-k3", "text": "kimi-k3 (recomendado)" },
        { "value": "kimi-k2.6", "text": "kimi-k2.6" },
        { "value": "kimi-k2.7-code-highspeed", "text": "kimi-k2.7-code-highspeed" },
        { "value": "kimi-k2.5", "text": "kimi-k2.5" },
        { "value": "moonshot-v1-128k", "text": "moonshot-v1-128k" }
      ],
      "default": "kimi-k3"
    },
    "kimi.reasoningEffort": {
      "text": "Reasoning effort (K3)",
      "description": "Solo Kimi K3: low / high / max. Ver docs oficiales.",
      "type": "dropdown",
      "options": [
        { "value": "low", "text": "low" },
        { "value": "high", "text": "high" },
        { "value": "max", "text": "max" }
      ],
      "default": "low"
    },
    "kimi.temperature": {
      "text": "Temperature",
      "description": "Creatividad (0 = más determinista).",
      "type": "number",
      "default": 0.2
    }
  }
}
